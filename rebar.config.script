{ok, VersionData} = file:read_file("VERSION"),
Version = binary_to_list(string:trim(VersionData)),
VersionDefine = {d, 'RETINUE_VERSION', Version},
SetVersion = fun(Config) ->
    ErlOpts = proplists:get_value(erl_opts, Config, []),
    Keep = fun({d, 'RETINUE_VERSION', _}) -> false;
              (_) -> true
           end,
    lists:keystore(erl_opts, 1, Config,
                   {erl_opts, [VersionDefine | lists:filter(Keep, ErlOpts)]})
end,
ConfigWithVersion = SetVersion(CONFIG),
Profiles = proplists:get_value(profiles, ConfigWithVersion, []),
VersionedProfiles = [{Name, SetVersion(Profile)} || {Name, Profile} <- Profiles],
lists:keystore(profiles, 1, ConfigWithVersion, {profiles, VersionedProfiles}).
