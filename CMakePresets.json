{
  "version": 6,
  "configurePresets": [
    {
      "name": "gui-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/llvm-libcxx.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/_build/vcpkg_installed",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/.cache/vcpkg/buildtrees;--x-packages-root=${sourceDir}/.cache/vcpkg/packages",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-ports",
        "VCPKG_HOST_TRIPLET": "x64-linux-llvm-libcxx",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/apps/wfgui/qt",
        "VCPKG_TARGET_TRIPLET": "x64-linux-llvm-libcxx"
      },
      "environment": {
        "LD_LIBRARY_PATH": "$env{LLVM_ROOT}/lib:$penv{LD_LIBRARY_PATH}",
        "SCCACHE_DIR": "${sourceDir}/.cache/sccache",
        "SCCACHE_SERVER_UDS": "${sourceDir}/.cache/sccache.sock",
        "VCPKG_DEFAULT_BINARY_CACHE": "${sourceDir}/.cache/vcpkg/archives",
        "VCPKG_DOWNLOADS": "${sourceDir}/.cache/vcpkg/downloads"
      }
    },
    {
      "name": "gui-dev",
      "inherits": "gui-base",
      "displayName": "Qt reference development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dev"
      }
    },
    {
      "name": "gui-prod",
      "inherits": "gui-base",
      "displayName": "Qt reference production",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/prod",
        "WFCLI_CPU_BASELINE": "x86-64-v2"
      },
      "environment": {
        "WFCLI_CPU_BASELINE": "x86-64-v2"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gui-dev",
      "configurePreset": "gui-dev",
      "targets": ["wfgui"]
    },
    {
      "name": "gui-prod",
      "configurePreset": "gui-prod",
      "targets": ["wfgui"]
    }
  ]
}
