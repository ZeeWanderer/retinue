{gpb_opts, [
    {i, "proto"}, {ipath, "../retinue_core/proto"},
    {o_erl, "src/generated"}, {o_hrl, "src/generated"},
    {module_name_suffix, "_pb"},
    use_packages, {rename, {msg_fqname, base_name}},
    maps, {maps_key_type, binary}, strings_as_binaries, json,
    defs_as_maps, json_preserve_proto_field_names,
    json_always_print_fields_with_no_presence,
    {verify, always}
]}.
{provider_hooks, [{pre, [{compile, {protobuf, compile}}]}]}.
