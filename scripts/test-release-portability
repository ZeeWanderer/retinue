#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
qemu="${QEMU_X86_64:-$(command -v qemu-x86_64 || true)}"

if [[ -z "$qemu" ]]; then
    printf '%s\n' 'qemu-x86_64 not found; release portability test requires QEMU user emulation' >&2
    exit 1
fi

"$qemu" -cpu Nehalem-v1 "$root/prod/bin/wfcompanion" --help >/dev/null
"$qemu" -cpu Nehalem-v1 "$root/prod/bin/poe2companion" --help >/dev/null
"$qemu" -cpu Nehalem-v1 "$root/prod/bin/arccompanion" --help >/dev/null
"$qemu" -cpu Nehalem-v1 "$root/prod/bin/retinue-inspect" --help >/dev/null
"$qemu" -cpu Nehalem-v1 "$root/prod/libexec/unoodle" --version >/dev/null
"$qemu" -cpu Nehalem-v1 "$root/prod/bin/wfgui" --help >/dev/null
