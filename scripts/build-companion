#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="${1:-dev}"
manifest="$root/apps/wfcompanion/Cargo.toml"
target_dir="${CARGO_TARGET_DIR:-$root/_build/cargo}"
decompiler_target_dir="$target_dir/wf-luau-decompiler"
debug_bridge="$root/_build/native/$mode/wfcompanion-debug-output.exe"
tesseract_bin="$(command -v tesseract || true)"

case "$mode" in
    dev)
        cargo_profile=debug
        cargo_args=()
        cargo_targets=(--bins)
        cpu_baseline="${WFCLI_CPU_BASELINE:-}"
        ;;
    prod)
        cargo_profile=release
        cargo_args=(--release)
        cargo_targets=(--bins)
        # Warframe requires SSE4.2; v2 keeps release artifacts portable across supported CPUs.
        case "$(uname -m)" in
            x86_64) cpu_baseline="${WFCLI_CPU_BASELINE:-x86-64-v2}" ;;
            *) cpu_baseline="${WFCLI_CPU_BASELINE:-}" ;;
        esac
        ;;
    *)
        printf 'usage: %s dev|prod\n' "$0" >&2
        exit 2
        ;;
esac

rustflags="${RUSTFLAGS:-}"
if [[ -n "$cpu_baseline" ]]; then
    rustflags="${rustflags:+$rustflags }-Ctarget-cpu=$cpu_baseline -Clink-arg=-march=$cpu_baseline"
fi

RUSTFLAGS="$rustflags" CARGO_TARGET_DIR="$target_dir" \
    "$root/scripts/build-oozextract" "$mode"
"$root/scripts/build-debug-bridge" "$debug_bridge"
WFCOMPANION_BUILD_DEBUG_BRIDGE="$root/$mode/libexec/wfcompanion-debug-output.exe" \
    WFCOMPANION_BUILD_TESSERACT="$tesseract_bin" \
    WFCLI_CPU_BASELINE="$cpu_baseline" \
    RUSTFLAGS="$rustflags" \
    CARGO_TARGET_DIR="$target_dir" \
    "${CARGO:-cargo}" build "${cargo_args[@]}" "${cargo_targets[@]}" --locked --manifest-path "$manifest"
RUSTFLAGS="$rustflags" CARGO_TARGET_DIR="$target_dir" \
    "${CARGO:-cargo}" build "${cargo_args[@]}" --locked \
        --manifest-path "$root/apps/poe2companion/Cargo.toml"
RUSTFLAGS="$rustflags" CARGO_TARGET_DIR="$target_dir" \
    "${CARGO:-cargo}" build "${cargo_args[@]}" --locked \
        --manifest-path "$root/apps/arccompanion/Cargo.toml"
WFCOMPANION_BUILD_DEBUG_BRIDGE="$root/$mode/libexec/wfcompanion-debug-output.exe" \
    RUSTFLAGS="$rustflags" CARGO_TARGET_DIR="$target_dir" \
    "${CARGO:-cargo}" build "${cargo_args[@]}" --locked \
        --manifest-path "$root/apps/retinue-inspect/Cargo.toml"
RUSTC_BOOTSTRAP=1 \
    RUSTFLAGS="$rustflags" \
    CARGO_TARGET_DIR="$decompiler_target_dir" \
    "${CARGO:-cargo}" build "${cargo_args[@]}" --locked \
        --manifest-path "$root/tools/wf-luau-decompiler/Cargo.toml" \
        -p luau-lifter --bin wf-luau-decompiler

source "$root/scripts/lib/staging.sh"
stage_begin "$root/$mode"
mkdir -p "$stage/bin" "$stage/libexec"
mkdir -p "$stage/share/licenses/wfcompanion" "$stage/share/licenses/wf-luau-decompiler"
install -m 0755 "$debug_bridge" "$stage/libexec/wfcompanion-debug-output.exe"
install -m 0755 "$target_dir/oozextract/$cargo_profile/unoodle" "$stage/libexec/unoodle"
rm -rf "$stage/share/licenses/oozextract"
cp -a "$target_dir/oozextract/$cargo_profile/licenses/oozextract" "$stage/share/licenses/"
install -m 0755 "$target_dir/$cargo_profile/wfcompanion" "$stage/bin/wfcompanion"
install -m 0755 "$target_dir/$cargo_profile/poe2companion" "$stage/bin/poe2companion"
install -m 0755 "$target_dir/$cargo_profile/arccompanion" "$stage/bin/arccompanion"
install -m 0755 "$target_dir/$cargo_profile/retinue-inspect" "$stage/bin/retinue-inspect"
ln -sfn retinue-inspect "$stage/bin/wfinspect"
install -m 0755 "$decompiler_target_dir/$cargo_profile/wf-luau-decompiler" \
    "$stage/bin/wf-luau-decompiler"
install -m 0644 "$root/apps/wfcompanion/assets/LuauDecompiler-LICENSE.txt" \
    "$stage/share/licenses/wfcompanion/luau-decompiler.txt"
install -m 0644 "$root/tools/wf-luau-decompiler/LICENSE.txt" \
    "$stage/share/licenses/wf-luau-decompiler/LICENSE.txt"
stage_commit
printf '%s\n' "$root/$mode/bin/wfcompanion"
