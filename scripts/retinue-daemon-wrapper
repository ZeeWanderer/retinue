#!/usr/bin/env bash
set -euo pipefail

script="${BASH_SOURCE[0]}"
while [[ -L "$script" ]]; do
    directory="$(cd -P "$(dirname "$script")" && pwd)"
    target="$(readlink "$script")"
    case "$target" in
        /*) script="$target" ;;
        *) script="$directory/$target" ;;
    esac
done

root="$(cd -P "$(dirname "$script")/.." && pwd)"
flavor="$(tr -d '\r\n' < "$root/BUILD_FLAVOR")"
export RETINUE_BUILD_FLAVOR="$flavor"
export RETINUE_INSTALL_ROOT="$root"
if [[ "${1:-}" == "paths" && "$#" -eq 1 ]]; then
    exec "$root/bin/retinue" paths retinue_daemon
fi
exec "$root/libexec/retinue_daemon/bin/retinue_daemon" "$@"
