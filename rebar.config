{minimum_otp_vsn, "29"}.
{erl_opts, [debug_info, warn_obsolete_bool_op]}.
{project_app_dirs, ["apps/retinue_core", "apps/wfcore", "apps/poe2core",
                    "apps/retinue_cli", "apps/retinue_daemon"]}.
{src_dirs, [{"src", [{recursive, true}]}]}.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
%% gpb emits unused wire-type helpers in generated codecs.
{xref_ignores, [retinue_wire_pb, wf_native_pb, wf_views_pb, poe2_native_pb]}.
{deps, [
    {yamerl, "~> 0.10"},
    {jsone, "~> 1.9"},
    {gun, "2.5.0"},
    {dirtree, "1.0.5"}
]}.
{plugins, [{rebar3_gpb_plugin, "3.0.1"}]}.
{pre_hooks, [{compile, "bash scripts/protobuf-deps"}]}.
{escript_name, retinue}.
{escript_main_app, retinue_cli}.
{escript_main_module, retinue_cli}.
{escript_incl_apps, [retinue_cli, retinue_core, wfcore, poe2core, retinue_daemon, yamerl, jsone, gun,
                     dirtree, gleam_stdlib]}.

{relx, [
    {release, {retinue_daemon, {file, "VERSION"}}, [
        retinue_daemon,
        sasl
    ]},

    {mode, dev},
    {dev_mode, false},
    {include_erts, true},
    {include_src, false},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

{profiles, [
    {prod, [
        {erl_opts, [no_debug_info]},
        {relx, [
            {mode, prod}
        ]}
    ]}
]}.
